{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": false,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": true,
    "useUnknownInCatchVariables": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "vite/client", "vitest/globals"],
    "baseUrl": ".",
    "paths": {
      "@ottie/contracts": ["packages/contracts/src/index.ts"],
      "@ottie/contracts/*": ["packages/contracts/src/*"],
      "@ottie/asset-registry": ["packages/asset-registry/src/index.ts"],
      "@ottie/asset-registry/*": ["packages/asset-registry/src/*"],
      "@ottie/scenario-core": ["packages/scenario-core/src/index.ts"],
      "@ottie/scenario-core/*": ["packages/scenario-core/src/*"],
      "@ottie/scenario-validation": ["packages/scenario-validation/src/index.ts"],
      "@ottie/scenario-validation/*": ["packages/scenario-validation/src/*"],
      "@ottie/renderer-geometry": ["packages/renderer/geometry/src/index.ts"],
      "@ottie/renderer-geometry/*": ["packages/renderer/geometry/src/*"],
      "@ottie/renderer-cameras": ["packages/renderer/cameras/src/index.ts"],
      "@ottie/renderer-cameras/*": ["packages/renderer/cameras/src/*"],
      "@ottie/renderer-evidence": ["packages/renderer/evidence/src/index.ts"],
      "@ottie/renderer-evidence/*": ["packages/renderer/evidence/src/*"],
      "@ottie/learning-state": ["packages/learning-state/src/index.ts"],
      "@ottie/learning-state/*": ["packages/learning-state/src/*"],
      "@ottie/review-export": ["packages/review-export/src/index.ts"],
      "@ottie/review-export/*": ["packages/review-export/src/*"],
      "@ottie/starter-content": ["packages/starter-content/src/index.ts"],
      "@ottie/starter-content/*": ["packages/starter-content/src/*"],
      "@ottie/content/*": ["content/*"],
      "@ottie/sg-assets/*": ["assets/sg/*"],
      "@ottie/web/*": ["apps/web/src/*"]
    }
  },
  "include": [
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "tools/scenario-review/**/*.ts",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "config/**/*.ts",
    "apps/web/vite.config.ts",
    "vitest.config.ts",
    "eslint.config.js"
  ],
  "exclude": ["node_modules", "dist", "apps/web/dist", "out", "coverage"]
}
