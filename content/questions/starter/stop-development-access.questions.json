        },
        {
          "id": "d",
          "text": "Neither: the car on the local road must also stop, because your stop line makes this an uncontrolled junction where everyone waits until it is empty.",
          "bindings": [
            { "role": "actual", "text": "car on the local road", "termId": null, "entityId": "local.car", "evidenceIds": ["ev.crossing-car"] },
            { "role": "actual", "text": "stop line", "termId": "stop-line", "entityId": "access.stop-line", "evidenceIds": ["ev.stop-line"] },
